# 本地运行所需环境变量示例（复制为 .env 后填写）

# —— 大模型通道（智谱 GLM-4-Flash，OpenAI 兼容）——
ZHIPU_API_KEY=your-zhipu-api-key
# 智谱 OpenAI 兼容基址，一般无需修改
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# —— 数据库（可选）——
# 留空则默认使用本地 SQLite（./delivery.db），零配置即可本地运行
# 如需 PostgreSQL，填连接串：postgresql+psycopg://user:pass@host:5432/dbname
PGDATABASE_URL=

# —— 投递状态库（可选，留空用上面的默认 SQLite）——
DELIVERY_DB_URL=

# —— 运行模式 ——
# workflow = 一次性投递流水线（默认，推荐本地先验证）；agent = 对话式求职顾问
APP_MODE=workflow

# —— BOSS 直聘自动检索（仅本地装了 Playwright + Chromium 时生效）——
# Cookie 走环境变量，切勿写入代码。可用 JSON 数组或 "k=v;k2=v2" 串
BOSS_COOKIE=
